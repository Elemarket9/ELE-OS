<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/bt_intro" />
        <Button android:id="@+id/bt_settings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/bt_settings" />
        <Button android:id="@+id/bt_scan" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/bt_scan" />
        <Button android:id="@+id/bt_pair" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/bt_pair" />
        <CheckBox android:id="@+id/bt_retry" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:checked="false" android:text="@string/bt_retry_opt_in" />
        <Button android:id="@+id/bt_connect" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/bt_connect" />
        <Button android:id="@+id/bt_disconnect" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/bt_disconnect" />
        <Button android:id="@+id/bt_close_all" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/bt_close_all" />
        <TextView android:id="@+id/bt_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
            android:text="@string/bt_initial" />
        <TextView android:id="@+id/bt_links" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
