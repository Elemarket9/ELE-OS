// Attribution installed with every product that inherits ele_talkback.mk.
// The APK module lives in Android.mk so a missing APK does not fail Soong
// for unrelated lunch targets. The product makefile still refuses to configure
// without talkback/EleTalkBack.apk.

prebuilt_etc {
    name: "EleTalkBackNotice",
    src: "NOTICE",
    product_specific: true,
}
