// Prototype voice screen. Not listed in PRODUCT_PACKAGES. The Cuttlefish
// product makefile is left unchanged: this app is not part of the default image.
android_app {
    name: "EleFaithVoice",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    sdk_version: "current",
    min_sdk_version: "35",
    product_specific: true,
}
